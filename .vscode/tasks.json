{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "AutoService: тесты",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "pytest"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "AutoService: Ruff",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "ruff", "check", "."],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "AutoService: форматирование — проверка",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "ruff", "format", "--check", "."],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "AutoService: все проверки",
      "dependsOrder": "sequence",
      "dependsOn": ["AutoService: Ruff", "AutoService: форматирование — проверка", "AutoService: тесты"],
      "problemMatcher": []
    }
  ]
}
